#!/usr/bin/env bash
# Обгортка запуску для Linux/macOS. Шлях до застосунку рахується відносно
# цього файлу, тому команда працює незалежно від поточної директорії
# (зокрема коли bin/ додано в PATH).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
ENTRY="$PROJECT_ROOT/src/secure_file_drop_entry.py"

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$ENTRY" "$@"
else
    exec python "$ENTRY" "$@"
fi
