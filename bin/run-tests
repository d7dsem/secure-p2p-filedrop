#!/usr/bin/env bash
# Обгортка запуску тестів для Linux/macOS. Шлях рахується відносно цього
# файлу, тому команда працює незалежно від поточної директорії.
# Групи по шарах (docs/architecture.md) — усі аргументи передаються далі
# в tests/_groups.py: назви груп/аліасів, прапорці unittest, дотовані імена.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
TESTS_DIR="$PROJECT_ROOT/tests"

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    PYTHON=python
fi

exec "$PYTHON" "$TESTS_DIR/_groups.py" "$@"
