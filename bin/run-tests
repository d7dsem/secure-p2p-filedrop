#!/usr/bin/env bash
# Обгортка запуску тестів для Linux/macOS. Шлях рахується відносно цього
# файлу, тому команда працює незалежно від поточної директорії.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
TESTS_DIR="$PROJECT_ROOT/tests"

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    PYTHON=python
fi

exec "$PYTHON" -m unittest discover -s "$TESTS_DIR" "$@"
